{
    "display_information": {
        "name": "P4PrometheusAlerts",
        "description": "Alerts from P4Prometheus for p4d blocked processes",
        "background_color": "#323336"
    },
    "features": {
        "bot_user": {
            "display_name": "P4PrometheusAlerts",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/update",
                "description": "Update the alert",
                "usage_hint": "[alert id]",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "app_mentions:read",
                "commands"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}